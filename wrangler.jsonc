{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foodcourt-kiosk-fyp",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-27",
  "vars": {
    "SITE_URL": "https://foodcourt-kiosk-fyp.rouhan28may.workers.dev",
    "STRIPE_CURRENCY": "pkr"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}